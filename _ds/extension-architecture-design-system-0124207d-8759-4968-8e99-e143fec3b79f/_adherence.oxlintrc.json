{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "portal/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Fraunces))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Fraunces."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:fill-red|fill-dark|fill-white|outline-dark|outline-red|outline-inverse|glass|text)$/]",
        "message": "<Button> variant must be one of 'fill-red' | 'fill-dark' | 'fill-white' | 'outline-dark' | 'outline-red' | 'outline-inverse' | 'glass' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|variant|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconCircle> doesn't accept that prop. Declared props: direction, variant, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up-right|left|right|down)$/]",
        "message": "<IconCircle> direction must be one of 'up-right' | 'left' | 'right' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|filled)$/]",
        "message": "<IconCircle> variant must be one of 'default' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute > JSXIdentifier[name!=/^(?:forceSolid|key|ref|className|style|children)$/]",
        "message": "<Nav> doesn't accept that prop. Declared props: forceSolid."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReadMore'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|arrow|onClick|style|inverse|key|ref|className|style|children)$/]",
        "message": "<ReadMore> doesn't accept that prop. Declared props: children, arrow, onClick, style, inverse."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|surface|eyebrow|title|intro|children|style|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: id, surface, eyebrow, title, intro, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:light|paper|bone|dark|brand)$/]",
        "message": "<Section> surface must be one of 'light' | 'paper' | 'bone' | 'dark' | 'brand'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
